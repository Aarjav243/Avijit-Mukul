rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /content/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /films/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /cinematography/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /writing/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /admins/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}